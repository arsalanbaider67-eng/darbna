# HTTPS certificates are fetched automatically once both names point at this server (DNS A records).
{
	# Reverse-proxy errors can include the full request even without access logs.
	log default {
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
}

# Access logging is intentionally disabled. Route/search requests include
# coordinates and search text; even redacted access logs retain client IPs.

routing.darbna.com {
	encode zstd gzip
	reverse_proxy valhalla:8002 {
		# The web app calls this from github.io / darbna.com.
		header_down Access-Control-Allow-Origin "*"
	}
}

# Public pages for the App Store listing and the app (privacy, support, prize rules), copied from
# apps/mobile/public by the deploy workflow. help.darbna.com/support → support.html, etc.
help.darbna.com {
	encode zstd gzip
	root * /srv/site
	redir / /support
	try_files {path}.html {path}
	file_server
	header Cache-Control "public, max-age=300"
}

search.darbna.com {
	encode zstd gzip
	reverse_proxy nominatim:8080 {
		header_down Access-Control-Allow-Origin "*"
	}
}
