# ---------------------------------------------------------------- server (secrets: server only)
NODE_ENV=production
PORT=8080
DATABASE_URL=postgres://darbna:CHANGE_ME@db:5432/darbna
POSTGRES_PASSWORD=CHANGE_ME
NOMINATIM_DB_PASSWORD=CHANGE_ME
# ≥ 32 random chars: openssl rand -base64 48. Rotating it unlinks all past votes/reports.
INSTALL_HASH_SECRET=
# Moderator API token: openssl rand -hex 32
ADMIN_TOKEN=
# Set true only behind a proxy you control (Caddy), so X-Forwarded-For is trusted.
TRUST_PROXY=true
MIGRATE_ON_START=true

# ---------------------------------------------------------------- providers (swap freely)
ROUTING_PROVIDER=valhalla          # valhalla | osrm  (osrm cannot avoid verified closures)
ROUTING_URL=http://valhalla:8002
ROUTING_TIMEOUT_MS=8000
GEOCODER_URL=http://nominatim:8080
GEOCODER_TIMEOUT_MS=4000
GEOCODER_USER_AGENT=Darbna/0.1 (ops@example.iq)

# Map styles the app loads. Self-hosted (infra/tiles) or a paid provider, e.g.
#   https://api.maptiler.com/maps/streets-v2/style.json?key=PUBLIC_RESTRICTED_KEY
# A key embedded in a style URL is visible to users: use the provider's
# app/domain restrictions on it. Do not put unrestricted keys here.
MAP_STYLE_DAY_URL=https://tiles.example.iq/styles/darbna-day.json
MAP_STYLE_NIGHT_URL=https://tiles.example.iq/styles/darbna-night.json
MAP_ATTRIBUTION=© OpenStreetMap contributors
TILES_PUBLIC_URL=https://tiles.example.iq

# Show demo reports (is_sample=true). Must be off in production.
SAMPLE_DATA=off
CORS_ORIGINS=

# ---------------------------------------------------------------- mobile app (public, baked into the build)
# apps/mobile reads EXPO_PUBLIC_* at build time. Never put secrets here.
EXPO_PUBLIC_API_URL=https://api.example.iq
